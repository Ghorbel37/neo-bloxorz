{
  "name": "neo-bloxorz",
  "version": "1.5.1",
  "private": true,
  "description": "A 2D shape-shifting block puzzle for mobile.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "check-levels": "node tools/check-levels.js",
    "serve": "npx --yes http-server www -c-1",
    "sync": "node tools/build.js android && cap sync android",
    "android": "cap open android",
    "build": "node tools/build.js",
    "build:web": "node tools/build.js web",
    "build:android": "node tools/build.js android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.63.0"
  }
}
